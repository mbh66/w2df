filters:
  and:
    - file.ext == "md"
    - type == "organisation"
    - draft != true
    - '!file.inFolder("templates")'
    - '!file.inFolder("private")'
formulas:
  organisation: file.asLink(title)
properties:
  formula.organisation:
    displayName: Organisation
  kind:
    displayName: Kind
  based_in:
    displayName: Based in
  connection:
    displayName: Link to the valley
  relationship:
    displayName: Contact with the Forum
views:
  - type: table
    name: All
    groupBy:
      property: kind
      direction: ASC
    order:
      - formula.organisation
      - connection
      - relationship
      - based_in
    sort:
      - property: title
        direction: ASC
